<!-- pages/courses/create/index.wxml -->
<mp-form id="form">
  <mp-cells title="Course Information">
    <mp-cell title="Title">
      <input data-field="title" bindinput="bindInputChange" placeholder="Enter course title" />
    </mp-cell>
    <mp-cell title="Instructor (Optional)">
      <input data-field="instructor" bindinput="bindInputChange" placeholder="Enter instructor name" />
    </mp-cell>
    <mp-cell title="Description">
      <textarea data-field="description" bindinput="bindInputChange" placeholder="Enter course description" style="height: 3.3em; width: 100%;" />
    </mp-cell>
  </mp-cells>

  <mp-cells title="Course Settings">
    <mp-cell title="Start Date">
      <picker mode="date" value="{{startDate}}" bindchange="bindDateChange">
        <view class="weui-input">{{startDate || 'Select date'}}</view>
      </picker>
    </mp-cell>
    <mp-cell title="Course Cycle">
      <picker bindchange="bindCycleChange" value="{{courseCycleDays}}" range="{{cycleOptions}}">
         <view class="weui-input">{{courseCycleDays}} days</view>
      </picker>
    </mp-cell>
  </mp-cells>

  <!-- Placeholder for Cover Image Uploader -->
  <!-- <mp-cells title="Cover Image (Optional)">
    <mp-uploader bindfail="uploadError" bindsuccess="uploadSuccess" max-count="1" title="Upload Image"></mp-uploader>
  </mp-cells> -->

  <view style="padding: 16px;">
    <mp-button type="primary" bindtap="submitCourse">Submit Course</mp-button>
  </view>
</mp-form>
