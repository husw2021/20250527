/* minglu_cloud_badge/miniprogram/pages/punchcard/index.wxss */
.container {
  padding: 10px;
}
.header {
  padding: 10px 16px;
  background-color: #f8f8f8;
  border-bottom: 1px solid #eee;
  margin-bottom: 10px;
}
.course-name-label {
  font-size: 14px;
  color: #888;
}
.course-name {
  font-size: 18px;
  font-weight: bold;
  color: #333;
}
.weui-input { /* For picker display */
  width: 100%;
  text-align: right;
}
.picker-placeholder {
  color: #888888;
}
.notes-textarea {
  height: 5em; /* Adjust as needed */
  width: 100%;
  padding: 8px 0; /* Align with cell title */
  font-size: 15px;
}
.mp-cell { /* Ensure cell aligns items nicely */
  align-items: center;
}
.success-animation-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 999;
}
.success-text {
  margin-top: 15px;
  font-size: 18px;
  color: white;
}
