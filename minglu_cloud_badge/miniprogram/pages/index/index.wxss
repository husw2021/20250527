/* pages/index/index.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
  box-sizing: border-box;
}
.avatar {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  margin-bottom: 10px;
}
.nickname {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 20px;
}
button {
  margin-top: 10px; /* Add some space between buttons */
  width: 80%;
}
